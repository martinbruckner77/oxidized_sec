#!/usr/bin/env ruby
# frozen_string_literal: true

require 'io/console'
require_relative '../lib/oxidized/secure_credentials'
abort 'usage: ruby bin/oxidized-credential encrypt' unless ARGV == ['encrypt']
$stderr.print 'Device password: '
secret = STDIN.noecho(&:gets)&.chomp
$stderr.puts
abort 'Empty password rejected' if secret.nil? || secret.empty?
puts Oxidized::SecureCredentials.encrypt(secret)
